# Kyro — variables de développement.
# Copie ce fichier en `.env` (jamais commité). En release, ces clés se règlent
# dans l'app (Réglages) : une clé embarquée dans un binaire distribué est publique.

# Réseau : "testnet" (Bitcoin testnet4, Sepolia, Solana devnet) ou "mainnet".
KYRO_NETWORK=testnet

# CoinGecko (prix du top 200). Optionnelle : sans clé, l'API publique est
# utilisée avec un cache plus long et un rate-limit plus strict.
# https://www.coingecko.com/en/api
KYRO_COINGECKO_API_KEY=

# Swap EVM via 0x (https://0x.org/docs). Optionnelle : sans clé, le swap EVM est désactivé.
KYRO_ZEROX_API_KEY=

# Swap EVM via 1inch (https://portal.1inch.dev). Optionnelle.
KYRO_ONEINCH_API_KEY=

# Cross-chain via LI.FI : fonctionne sans clé (quota réduit).
KYRO_LIFI_API_KEY=

# Jupiter (Solana) : l'endpoint public lite-api fonctionne sans clé.
KYRO_JUPITER_API_KEY=

# TronGrid (TRON mainnet et Nile, https://www.trongrid.io). Optionnelle : sans clé, quotas
# réduits, et certains relais de sortie Tor peuvent être refusés (HTTP 403). Envoyée en
# en-tête TRON-PRO-API-KEY à api.trongrid.io / nile.trongrid.io uniquement.
KYRO_TRONGRID_API_KEY=

# RPC personnalisés (facultatif ; sinon les nœuds publics listés dans docs/NETWORK.md).
KYRO_RPC_ETHEREUM=
KYRO_RPC_SOLANA=
KYRO_ESPLORA_BITCOIN=
