# Kyro — development variables.
# Copy this file to `.env` (never committed). In release builds, these keys are set
# in the app (Settings): a key embedded in a distributed binary is public.

# Network: "testnet" (Bitcoin testnet4, Sepolia, Solana devnet) or "mainnet". Takes precedence over
# the choice made in the app (Settings › Networks and servers), which is then locked. Without this
# variable: the saved choice, otherwise mainnet in release and testnet in debug (docs/IPC.md §2.10).
KYRO_NETWORK=testnet

# CoinGecko (top 200 prices). Optional: without a key, the public API is
# used with a longer cache and a stricter rate limit.
# https://www.coingecko.com/en/api
KYRO_COINGECKO_API_KEY=

# EVM swap via 0x (https://0x.org/docs). Optional: without a key, EVM swap is disabled.
KYRO_ZEROX_API_KEY=


# Cross-chain via LI.FI: works without a key (reduced quota).
KYRO_LIFI_API_KEY=

# Jupiter (Solana): the public lite-api endpoint works without a key.
KYRO_JUPITER_API_KEY=

# TronGrid (TRON mainnet and Nile, https://www.trongrid.io). Optional: without a key, reduced
# quotas, and some Tor exit relays may be refused (HTTP 403). Sent as the
# TRON-PRO-API-KEY header to api.trongrid.io / nile.trongrid.io only.
KYRO_TRONGRID_API_KEY=

# Custom RPCs (optional; otherwise the public nodes listed in docs/NETWORK.md).
KYRO_RPC_ETHEREUM=
KYRO_RPC_SOLANA=
KYRO_ESPLORA_BITCOIN=
