# Kyro — development variables.

# Network: "testnet" (Bitcoin testnet4, Sepolia, Solana devnet) or "mainnet".
KYRO_NETWORK=testnet

# CoinGecko (top 200 prices).
KYRO_COINGECKO_API_KEY=

# EVM swap via 0x (https://0x.org/docs). Optional: without a key, EVM swap is disabled.
KYRO_ZEROX_API_KEY=

# Cross-chain via LI.FI: works without a key (reduced quota).
KYRO_LIFI_API_KEY=

# Jupiter (Solana): the public lite-api endpoint works without a key.
KYRO_JUPITER_API_KEY=

# TronGrid (TRON mainnet and Nile, https://www.trongrid.io).
KYRO_TRONGRID_API_KEY=

# Custom RPCs (optional; otherwise the public nodes listed in docs/NETWORK.md).
KYRO_RPC_ETHEREUM=
KYRO_RPC_SOLANA=
KYRO_ESPLORA_BITCOIN=
