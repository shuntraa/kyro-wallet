# Cloudflare Pages HTTP headers (this file is not served).
# Everything comes from this site: no external resources, no inline scripts, no outside requests.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; media-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Install scripts: shown as text in a browser, fetched as text by irm / curl.
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
